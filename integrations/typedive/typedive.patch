+// Versioned output only: never changes candidate sets or analysis state.
+static std::string sourcePath(StringRef Directory, StringRef Filename) {
+    if (Filename.empty()) return "";
+    SmallString<256> Path(Filename);
+    if (!sys::path::is_absolute(Path)) {
+        Path = Directory;
+        sys::path::append(Path, Filename);
+    }
+    sys::path::remove_dots(Path, true);
+    return std::string(Path.str());
+}
+
+static void printPair(CallInst *CI, Function *F) {
+    if (!CI) return;
+    // Ordinal among ALL instructions distinguishes void calls, identical IR
+    // text, and multiple inlined callsites sharing a debug source location.
+    int64_t Ordinal = 0;
+    for (auto &I : instructions(CI->getFunction())) {
+        if (&I == CI) break;
+        ++Ordinal;
+    }
+    std::string IR;
+    raw_string_ostream Stream(IR);
+    CI->print(Stream);
+    Stream.flush();
+    auto Loc = CI->getDebugLoc();
+    auto SP = F->getSubprogram();
+    json::Object Pair{
+        {"schema_version", 1}, {"mode", ENABLE_MLTA},
+        {"caller_module", CI->getModule()->getModuleIdentifier()},
+        {"caller_function", CI->getFunction()->getName()},
+        {"caller_instruction", Ordinal}, {"caller_ir", IR},
+        {"caller_file", Loc ? sourcePath(Loc->getDirectory(), Loc->getFilename()) : ""},
+        {"caller_line", Loc ? int64_t(Loc.getLine()) : 0},
+        {"caller_column", Loc ? int64_t(Loc.getCol()) : 0},
+        {"callee_module", F->getParent()->getModuleIdentifier()},
+        {"callee_function", F->getName()},
+        {"callee_file", SP ? sourcePath(SP->getDirectory(), SP->getFilename()) : ""},
+        {"callee_line", SP ? int64_t(SP->getLine()) : 0},
+        {"callee_declaration", F->isDeclaration()}
+    };
+    OP << "ICALLCOV_PAIR_V1\t" << json::Value(std::move(Pair)) << "\n";
+}
